  "phrases": [
    {
      "token": "$vgc_reyes_title",
      "owner": "vgc_reyes",
      "mode": "first-match",
      "cases": [
        {
          "when": [
            "$player.commissionFactionId == vgc_vanguard"
          ],
          "text": "Commander"
        },
        {
          "when": [
            "SF_AtStep vgc_q find",
            "!$global.vgc_rude"
          ],
          "text": "Captain"
        }
      ],
      "otherwise": "Spacer"
    }
  ],
  "steps": [
    {
      "token": "$vgc_reyes_title",
      "is": "Spacer"
    },
    {
      "do": "SF_Step vgc_q find"
    },
    {
      "token": "$vgc_reyes_title",
      "is": "Captain"
    },
    {
      "do": "$global.vgc_rude = true"
    },
    {
      "token": "$vgc_reyes_title",
      "is": "Spacer"
    },
    {
      "do": "$player.commissionFactionId = vgc_vanguard"
    },
    {
      "token": "$vgc_reyes_title",
      "is": "Commander"
    }
  ]
}
